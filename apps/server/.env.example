# Server Runtime Environment (development | staging | production | test)
NODE_ENV=development
PORT=5000

# Database Connection (MongoDB URI)
MONGODB_URI=mongodb://127.0.0.1:27017/fixme
# Optional DNS resolvers (comma-separated IP addresses for Node.js SRV lookup on Windows, defaults to 8.8.8.8,1.1.1.1)
DNS_SERVERS=8.8.8.8,1.1.1.1

# Trusted Frontend Application Origins (CORS & Redirection)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
SELLER_URL=http://localhost:5175

# Session & Token Secret (HMAC-SHA256, minimum 32 characters in production)
SESSION_SECRET=replace_with_a_secure_random_secret_at_least_32_chars

# Media & Storage Provider (local | cloudinary | s3)
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment Gateway Integration (Razorpay Sandbox or Mock)
PAYMENT_PROVIDER=razorpay_sandbox
PAYMENT_SECRET_KEY=sandbox_secret_key
PAYMENT_WEBHOOK_SECRET=sandbox_webhook_secret

# Transactional Email Service
EMAIL_PROVIDER_API_KEY=sandbox_email_key

# Optional Initial Administrator Bootstrap Credentials (never commit real passwords)
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace_with_secure_admin_password
